model SalesShipmentLine {
  id               String  @id @default(uuid(7))
  organizationId   String  @map("organization_id")
  salesShipmentId  String  @map("sales_shipment_id")
  salesOrderLineId String  @map("sales_order_line_id")
  quantity         Decimal @db.Decimal(18, 4)
  /// Lote del que sale la mercancia. Obligatorio si el producto se rastrea por
  /// lote. Por omision se propone el de caducidad mas proxima.
  lotId            String? @map("lot_id")

  shipment  SalesShipment  @relation(fields: [salesShipmentId], references: [id], onDelete: Cascade)
  orderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)

  @@index([salesOrderLineId])
  @@map("sales_shipment_lines")
}

// =============================================================================
// Infraestructura: auditoria, idempotencia y bandeja de salida
// =============================================================================

/// Bitacora de auditoria. Tabla de SOLO INSERCION.
/// Nunca contiene contrasenas, secretos ni datos personales innecesarios.
model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String?  @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  correlationId  String   @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Correlativo de documentos. RN-060.
///
/// Se modela como tabla y no como secuencia de PostgreSQL porque una secuencia
/// no es transaccional: al revertir una operacion el numero se pierde y quedan
/// huecos, que en varios paises no son aceptables fiscalmente. Aqui el numero
/// se reserva bloqueando esta fila dentro de la misma transaccion que crea el
/// documento, de modo que si la operacion falla el numero vuelve a estar libre.
///
/// El precio de esa garantia es que las creaciones del mismo tipo de documento
/// en la misma empresa se serializan. Es aceptable: son operaciones humanas,
/// no masivas.
model DocumentSequence {
  id             String @id @default(uuid(7))
  organizationId String @map("organization_id")
  /// Pais al que pertenece la serie. Una empresa que opera en dos paises lleva
  /// correlativos independientes en cada uno.
  countryCode    String @map("country_code") @db.Char(2)
  /// Tipo de documento: PURCHASE_ORDER, PURCHASE_RECEIPT, SALES_ORDER,
  /// SALES_SHIPMENT, STOCK_ADJUSTMENT, STOCK_TRANSFER.
  documentType   String @map("document_type")
  /// Ejercicio al que pertenece la serie. El correlativo reinicia cada año.
  year           Int
  /// Ultimo numero entregado. El siguiente documento recibe este valor mas uno.
  lastNumber     Int    @default(0) @map("last_number")
  /// Prefijo mostrado. Ejemplo: OC para orden de compra.
  prefix         String
  /// Digitos de relleno del correlativo. Con cuatro digitos, 000001 seria 0001.
  padding        Int    @default(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, countryCode, documentType, year])
  @@map("document_sequences")
}

/// Evita que un doble envio o un reintento del cliente genere movimientos
/// duplicados. Se purga por antiguedad.
model IdempotencyKey {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([organizationId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Bandeja de salida. Todo efecto externo que deba ocurrir exactamente una vez
/// se escribe aqui dentro de la transaccion de negocio y se procesa despues.
model OutboxEvent {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  type           String
  payload        Json
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}
