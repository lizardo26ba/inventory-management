/// Lote de un producto. Solo existe para productos con rastreo por lote.
/// El saldo de esos productos se lleva por lote, no solo por almacen.
model Lot {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  /// Codigo de lote del fabricante o del proveedor.
  code           String
  manufacturedAt DateTime? @map("manufactured_at") @db.Date
  /// Fecha de caducidad. Nula cuando el producto no caduca.
  expiresAt      DateTime? @map("expires_at") @db.Date
  /// Proveedor del que llego el lote, para trazabilidad de retiradas.
  supplierId     String?   @map("supplier_id")
  notes          String?

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  stockLevels   StockLevel[]
  movements     StockMovement[]
  serialNumbers SerialNumber[]

  @@unique([organizationId, productId, code])
  /// Indice que sostiene la salida por caducidad mas proxima y la alerta de
  /// productos por vencer.
  @@index([organizationId, productId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([supplierId])
  @@map("lots")
}

/// Unidad individual identificada. Solo existe para productos con rastreo por
/// serie. Su ubicacion y estado viven aqui, no en el saldo agregado.
model SerialNumber {
  id             String       @id @default(uuid(7))
  organizationId String       @map("organization_id")
  productId      String       @map("product_id")
  serial         String
  /// Un producto puede rastrearse por serie y pertenecer ademas a un lote.
  lotId          String?      @map("lot_id")
  status         SerialStatus @default(IN_STOCK)
  /// Almacen donde esta la unidad. Nulo cuando ya salio.
  warehouseId    String?      @map("warehouse_id")
  /// Costo de adquisicion de esta unidad, en moneda base.
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(18, 4)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot       Lot?                  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements StockMovementSerial[]

  @@unique([organizationId, productId, serial])
  @@index([organizationId, status, warehouseId])
  @@index([lotId])
  @@map("serial_numbers")
}

/// Libro mayor de existencias. Tabla de SOLO INSERCION.
/// Nunca se actualiza ni se borra una fila. Una correccion es un movimiento
/// nuevo de signo contrario que apunta al original en correctsMovementId.
model StockMovement {
  id             String         @id @default(uuid(7))
  organizationId String         @map("organization_id")
  productId      String         @map("product_id")
  warehouseId    String         @map("warehouse_id")
  /// Lote afectado. Obligatorio cuando el producto se rastrea por lote,
  /// nulo cuando no. La aplicacion lo exige segun trackingMode del producto.
  lotId          String?        @map("lot_id")
  type           MovementType
  reason         MovementReason
  /// Cantidad con signo. Positiva entra, negativa sale. Nunca cero.
  quantity       Decimal        @db.Decimal(18, 4)
  /// Costo unitario del movimiento, SIEMPRE en la moneda base de la
  /// organizacion. La conversion ocurre al registrar el movimiento, usando la
  /// tasa congelada en el documento de origen. Guardarlo ya convertido evita
  /// que el valor del inventario cambie al fluctuar el tipo de cambio.
  unitCost       Decimal?       @map("unit_cost") @db.Decimal(18, 4)

  /// Documento de origen. Se guarda como par tipo mas identificador en lugar de
  /// una clave foranea por cada tipo de documento, para no acoplar el libro a
  /// cada proceso que lo alimenta.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  /// Movimiento que esta fila corrige, si aplica.
  correctsMovementId String? @map("corrects_movement_id")

  note        String?
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot         Lot?                  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  corrects    StockMovement?        @relation("MovementCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict)
  correctedBy StockMovement[]       @relation("MovementCorrection")
  serials     StockMovementSerial[]

  @@index([organizationId, productId, warehouseId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([warehouseId])
  @@index([lotId])
  @@map("stock_movements")
}

/// Unidades con numero de serie que participan en un movimiento.
/// Un movimiento de producto serializado mueve tantas unidades como filas
/// tenga aqui, y su cantidad debe coincidir con ese conteo.
model StockMovementSerial {
  movementId     String @map("movement_id")
  serialNumberId String @map("serial_number_id")

  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  serial   SerialNumber  @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)

  @@id([movementId, serialNumberId])
  @@index([serialNumberId])
  @@map("stock_movement_serials")
}

/// Saldo materializado. Se actualiza SIEMPRE en la misma transaccion que
/// inserta el movimiento, en aislamiento serializable.
model StockLevel {
  id             String  @id @default(uuid(7))
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  warehouseId    String  @map("warehouse_id")
  /// Lote al que corresponde este saldo. Nulo para productos sin rastreo por
  /// lote. La unicidad se declara en la migracion con NULLS NOT DISTINCT,
  /// porque en PostgreSQL dos valores nulos no chocan por omision y eso
  /// permitiria dos saldos para el mismo producto y almacen.
  lotId          String? @map("lot_id")

  quantity         Decimal @default(0) @db.Decimal(18, 4)
  /// Costo promedio ponderado, recalculado en cada entrada.
  averageCost      Decimal @default(0) @map("average_cost") @db.Decimal(18, 4)
  /// Cantidad comprometida por pedidos de venta confirmados y no despachados.
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(18, 4)

  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot       Lot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId, lotId])
  @@index([organizationId, warehouseId])
  @@index([lotId])
  @@map("stock_levels")
}

