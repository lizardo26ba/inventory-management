// Esquema de datos del sistema de Inventario.
//
// Reglas que gobiernan este archivo: .claude/agents/database-architect.md
// Decisiones de fondo:
//   ADR 0002 - existencias como libro de movimientos inmutable
//   ADR 0003 - multiempresa con identificador de organizacion
//   ADR 0004 - autenticacion con credenciales propias
//   ADR 0005 - super administrador de plataforma con acceso auditado
//   ADR 0006 - operacion multipais con moneda base por organizacion
//   ADR 0007 - sesion propia en base de datos, sin libreria de autenticacion
//   ADR 0008 - rastreo por lote y por numero de serie
//
// Convenciones aplicadas:
//   - Tablas y columnas en snake_case mediante @map / @@map.
//   - Clave primaria UUID v7, ordenable en el tiempo. Requiere Prisma 6 o superior.
//   - Importes y cantidades en Decimal(18,4). Nunca punto flotante.
//   - Fechas en timestamptz, siempre en UTC, y el valor que se escribe es el momento
//     actual en esa escala: now() al insertar, @updatedAt al modificar. La zona horaria
//     se aplica al presentar, nunca al guardar. Ver docs/standards/dates-and-times.md
//   - organizationId presente en toda tabla de negocio, y primero en cada indice.
//   - Los sellos de auditoria createdById / updatedById son escalares sin relacion de
//     Prisma, para no generar decenas de relaciones inversas en User. La clave foranea
//     real, con su indice, vive en la migracion 20260915033139_sellos_de_autoria. Es una
//     decision consciente, no un olvido: sin relacion en Prisma pero con restriccion en
//     la base, que es donde tiene que estar.
//   - Toda entidad que una persona pueda modificar lleva los dos sellos y son obligatorios.
//     updatedById es quien la toco por ultima vez, incluida la creacion, asi que al
//     insertar vale lo mismo que createdById. Lo inmutable, que son movimientos, lotes,
//     recepciones y despachos, lleva solo createdById: no se edita nunca. ADR 0002, RN-033.

generator client {
  provider = "prisma-client-js"
}

// Unico lugar del proyecto, junto al modulo de configuracion, autorizado a leer
// variables de entorno. Prisma lo exige en tiempo de generacion.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================================================================
// Enumeraciones
// =============================================================================

enum PermissionScope {
  ORGANIZATION
  PLATFORM

  @@map("permission_scope")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

/// Como se rastrea un producto. Determina el grano del saldo de existencias.
enum TrackingMode {
  /// Solo cantidad por producto y almacen.
  NONE
  /// Cantidad por producto, almacen y lote. El lote puede tener caducidad.
  LOT
  /// Cada unidad tiene numero de serie unico. La cantidad siempre es uno.
  SERIAL

  @@map("tracking_mode")
}

enum SerialStatus {
  IN_STOCK
  SHIPPED
  RETURNED
  SCRAPPED

  @@map("serial_status")
}

enum MovementType {
  RECEIPT // entrada
  ISSUE // salida
  TRANSFER_IN // entrada por transferencia
  TRANSFER_OUT // salida por transferencia
  ADJUSTMENT // ajuste por conteo
  CORRECTION // correccion de un movimiento anterior

  @@map("movement_type")
}

enum MovementReason {
  PURCHASE_RECEIPT
  SALES_SHIPMENT
  TRANSFER
  CYCLE_COUNT
  DAMAGE
  LOSS
  RETURN_FROM_CUSTOMER
  RETURN_TO_SUPPLIER
  CORRECTION
  INITIAL_LOAD

  @@map("movement_reason")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED

  @@map("sales_order_status")
}

// =============================================================================
// Catalogos globales. Ver ADR 0006.
// No llevan organizationId: son datos del producto, iguales para todos.
// =============================================================================

/// Paises soportados, segun ISO 3166-1 alfa-2.
model Country {
  id                  String  @id @default(uuid(7))
  /// Codigo ISO de dos letras. GT, MX, ES, US.
  code                String  @unique @db.Char(2)
  name                String
  defaultCurrencyCode String  @map("default_currency_code") @db.Char(3)
  /// Zona horaria IANA por omision para las organizaciones de este pais.
  defaultTimeZone     String  @map("default_time_zone")
  /// Etiqueta local del identificador fiscal: NIT, RFC, RUC, CUIT, NIF.
  taxIdLabel          String  @map("tax_id_label")
  /// Expresion regular de validacion del identificador fiscal en este pais.
  taxIdPattern        String? @map("tax_id_pattern")
  phonePrefix         String  @map("phone_prefix")
  /// Plantilla del numero nacional: cada # es un digito, el resto separadores.
  phoneMask           String  @default("") @map("phone_mask")
  /// Un numero de ejemplo, ya separado, para el texto de ayuda del formulario.
  phoneExample        String  @default("") @map("phone_example")
  isActive            Boolean @default(true) @map("is_active")

  defaultCurrency Currency       @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  organizations   Organization[]
  users           User[]
  warehouses      Warehouse[]
  suppliers       Supplier[]
  customers       Customer[]

  @@map("countries")
}

/// Monedas soportadas, segun ISO 4217.
model Currency {
  id            String  @id @default(uuid(7))
  /// Codigo ISO de tres letras. GTQ, MXN, USD, EUR.
  code          String  @unique @db.Char(3)
  name          String
  symbol        String
  /// Decimales de presentacion. Tres para KWD, cero para JPY, dos en la mayoria.
  /// El almacenamiento siempre usa Decimal(18,4), independiente de este valor.
  decimalPlaces Int     @default(2) @map("decimal_places")
  isActive      Boolean @default(true) @map("is_active")

  countries      Country[]
  organizations  Organization[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  ratesFrom      ExchangeRate[]  @relation("ExchangeRateFrom")
  ratesTo        ExchangeRate[]  @relation("ExchangeRateTo")

  @@map("currencies")
}

/// Tipo de cambio con vigencia diaria. El documento congela la tasa que usó,
/// de modo que un cambio posterior de la tasa no altere importes historicos.
model ExchangeRate {
  id           String   @id @default(uuid(7))
  fromCurrency String   @map("from_currency") @db.Char(3)
  toCurrency   String   @map("to_currency") @db.Char(3)
  /// Unidades de destino por una unidad de origen.
  rate         Decimal  @db.Decimal(18, 8)
  validOn      DateTime @map("valid_on") @db.Date
  source       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  from Currency @relation("ExchangeRateFrom", fields: [fromCurrency], references: [code], onDelete: Restrict)
  to   Currency @relation("ExchangeRateTo", fields: [toCurrency], references: [code], onDelete: Restrict)

  @@unique([fromCurrency, toCurrency, validOn])
  @@index([validOn])
  @@map("exchange_rates")
}

// =============================================================================
// Organizacion, identidad y control de acceso
// =============================================================================

model Organization {
  id               String  @id @default(uuid(7))
  slug             String  @unique
  /// Nombre comercial, el que usa la gente a diario.
  name             String
  /// Nombre que aparece en los documentos fiscales. No suele coincidir con el
  /// comercial y es el que se imprime en una factura.
  legalName        String  @map("legal_name")
  countryCode      String  @map("country_code") @db.Char(2)
  /// Moneda de valoracion del inventario y de los informes de esta organizacion.
  /// Todo costo de existencias se almacena convertido a esta moneda.
  baseCurrencyCode String  @map("base_currency_code") @db.Char(3)
  /// Zona horaria IANA de la organizacion. Determina el corte de los informes
  /// diarios. Los almacenes de otro pais pueden tener la suya propia.
  timeZone         String  @map("time_zone")
  /// Idioma de respaldo de la organizacion, usado solo cuando un usuario nuevo
  /// todavia no ha elegido el suyo. El idioma real es preferencia del usuario,
  /// no de la empresa. RN-010.
  locale           String  @default("en")
  taxId            String? @map("tax_id")

  /// Datos de contacto. Acaban impresos en documentos, asi que viven con la
  /// organizacion y no en una tabla aparte.
  email   String?
  phone   String?
  address String?

  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(0)
  createdById String    @map("created_by_id")
  updatedById String    @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  country      Country      @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  baseCurrency Currency     @relation(fields: [baseCurrencyCode], references: [code], onDelete: Restrict)
  memberships  Membership[]
  roles        Role[]

  @@index([countryCode])
  /// Dos organizaciones del mismo pais no pueden compartir identificador fiscal:
  /// es una identidad ante una administracion tributaria, y repetirla significa
  /// que una de las dos esta mal registrada. Entre paises no choca, porque cada
  /// administracion numera por su cuenta. El indice se crea como parcial en una
  /// migracion SQL, para que las organizaciones todavia sin identificador no
  /// choquen entre ellas.
  @@map("organizations")
}

/// Identidad global. Una persona puede pertenecer a varias organizaciones.
/// No lleva organizationId: el vinculo se expresa en Membership.
model User {
  id                  String     @id @default(uuid(7))
  email               String     @unique
  passwordHash        String     @map("password_hash")
  /// El nombre va partido en dos columnas porque las listas se ordenan y se
  /// buscan por apellido. Quien tenga dos apellidos los escribe juntos en el
  /// segundo campo: partirlo mas seria inventar una estructura que no todos los
  /// paises comparten.
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  /// Pais de la persona, no de la empresa: una misma persona puede trabajar para
  /// empresas de varios paises. Se usa para presentar sus datos y para el
  /// formato telefonico. Opcional porque las cuentas creadas antes de que
  /// existiera la columna no lo tienen, y adivinarlo seria inventar un dato.
  countryCode         String?    @map("country_code") @db.Char(2)
  status              UserStatus @default(INVITED)
  /// Idioma de la interfaz. Es preferencia del usuario, no de la empresa. RN-010.
  locale              String     @default("en")
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// Obliga a cambiar la contrasena antes de poder hacer cualquier otra cosa.
  /// Nace en verdadero para las cuentas creadas por semilla o por invitacion,
  /// donde la contrasena inicial la conoce alguien mas que su dueno.
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  /// Secreto del segundo factor, cifrado en reposo por la aplicacion.
  twoFactorSecret     String?    @map("two_factor_secret")
  twoFactorEnabledAt  DateTime?  @map("two_factor_enabled_at") @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  version             Int        @default(0)
  createdById         String     @map("created_by_id")
  updatedById         String     @map("updated_by_id")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  country        Country?             @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]           @relation("AuditLogActor")
  platformAdmin  PlatformAdmin?       @relation("PlatformAdminUser")
  grantedAdmins  PlatformAdmin[]      @relation("PlatformAdminGrantedBy")

  @@index([status])
  @@index([countryCode])
  @@map("users")
}

/// Super administrador de la plataforma. Ver ADR 0005.
///
/// Se modela como tabla aparte y no como bandera en User por tres razones:
/// queda registrado quien concedio el acceso y por que, la revocacion deja
/// rastro en lugar de borrar el hecho, y la consulta de "quienes son super
/// administradores" es una sola lectura auditable.
///
/// Un super administrador NO obtiene datos por omision. Debe elegir de forma
/// explicita la organizacion en la que actua, lo que rota su sesion y queda
/// asentado en la bitacora de auditoria.
model PlatformAdmin {
  id          String    @id @default(uuid(7))
  userId      String    @unique @map("user_id")
  /// Motivo por el que se concedio. Obligatorio: sirve en la revision periodica.
  reason      String
  grantedById String    @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById String?   @map("revoked_by_id")

  user      User @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PlatformAdminGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([revokedAt])
  @@map("platform_admins")
}

model Session {
  id                    String    @id @default(uuid(7))
  /// Hash del token de sesion. El valor en claro solo existe en la cookie.
  tokenHash             String    @unique @map("token_hash")
  userId                String    @map("user_id")
  /// Organizacion activa de la sesion. Cambiarla rota la sesion.
  organizationId        String?   @map("organization_id")
  /// Verdadero cuando un super administrador entra a una organizacion de la que
  /// no es miembro. Hace visible el privilegio elevado en cada registro de
  /// auditoria y permite mostrarlo en la interfaz mientras esta activo.
  actingAsPlatformAdmin Boolean   @default(false) @map("acting_as_platform_admin")
  /// Segundo factor superado en esta sesion. Obligatorio para los super
  /// administradores antes de poder elegir organizacion.
  twoFactorVerifiedAt   DateTime? @map("two_factor_verified_at") @db.Timestamptz(6)
  ipAddress             String?   @map("ip_address")
  userAgent             String?   @map("user_agent")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Pertenencia de un usuario a una organizacion. Los roles se asignan aqui,
/// de modo que la misma persona tenga permisos distintos en cada organizacion.
model Membership {
  id             String    @id @default(uuid(7))
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]
  warehouses   WarehouseAccess[]

  @@unique([userId, organizationId])
  @@index([organizationId, isActive])
  @@map("memberships")
}

/// Catalogo global de permisos, en formato recurso:accion.
/// No lleva organizationId: el conjunto de permisos posibles es del producto,
/// no de cada cliente. Lo que varia por organizacion es como se agrupan en roles.
model Permission {
  id          String          @id @default(uuid(7))
  code        String          @unique
  resource    String
  action      String
  description String
  /// ORGANIZATION: se concede mediante roles dentro de una organizacion.
  /// PLATFORM: solo lo obtiene un super administrador. Nunca se asigna a un rol.
  scope       PermissionScope @default(ORGANIZATION)

  roles RolePermission[]

  @@index([resource])
  @@index([scope])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  /// Identificador estable de un rol del sistema: admin, purchasing, sales,
  /// warehouse, viewer. Permite que la interfaz muestre su nombre en el idioma
  /// de quien mira, y que renombrarlo no rompa nada. Los roles que crea una
  /// empresa no llevan codigo: su nombre es el que su autor escribio.
  code           String?
  name           String
  description    String?
  /// Rol creado por el sistema al dar de alta la organizacion. No se puede borrar.
  isSystem       Boolean  @default(false) @map("is_system")
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String   @map("membership_id")
  roleId       String   @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// Restringe a que almacenes alcanza una membresia. Sin filas, la membresia
/// alcanza todos los almacenes de su organizacion.
model WarehouseAccess {
  id           String   @id @default(uuid(7))
  membershipId String   @map("membership_id")
  warehouseId  String   @map("warehouse_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([membershipId, warehouseId])
  @@index([warehouseId])
  @@map("warehouse_access")
}

// =============================================================================
// Catalogos
// =============================================================================

model Warehouse {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  code           String
  name           String
  address        String?
  /// Una organizacion puede operar almacenes en varios paises. El pais y la
  /// zona horaria del almacen mandan sobre los de la organizacion para el
  /// corte de inventario y la hora que se muestra en los movimientos.
  countryCode    String    @map("country_code") @db.Char(2)
  timeZone       String    @map("time_zone")
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  country        Country           @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  access         WarehouseAccess[]
  stockLevels    StockLevel[]
  movements      StockMovement[]
  serialNumbers  SerialNumber[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([countryCode])
  @@map("warehouses")
}

model UnitOfMeasure {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  code           String
  name           String
  /// Si es falso, las cantidades de sus productos deben ser enteras.
  allowsFraction Boolean   @default(false) @map("allows_fraction")
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]

  @@unique([organizationId, code])
  @@map("units_of_measure")
}

model Category {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  parentId       String?   @map("parent_id")
  name           String
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId, parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  sku            String
  barcode        String?
  name           String
  description    String?
  categoryId     String?  @map("category_id")
  unitId         String   @map("unit_id")
  /// Umbral de reposicion. Cero significa sin alerta.
  minimumStock   Decimal  @default(0) @map("minimum_stock") @db.Decimal(18, 4)
  maximumStock   Decimal? @map("maximum_stock") @db.Decimal(18, 4)
  standardCost   Decimal  @default(0) @map("standard_cost") @db.Decimal(18, 4)
  salePrice      Decimal  @default(0) @map("sale_price") @db.Decimal(18, 4)
  isActive       Boolean  @default(true) @map("is_active")

  /// Grano con el que se rastrea este producto. Cambiarlo con existencias
  /// distintas de cero esta prohibido: obligaria a inventar lotes o series
  /// para el saldo que ya existe.
  trackingMode    TrackingMode @default(NONE) @map("tracking_mode")
  /// Vida util en dias desde la fabricacion. Solo aplica con rastreo por lote.
  /// Sirve para proponer la caducidad al recibir, no la impone.
  shelfLifeDays   Int?         @map("shelf_life_days")
  /// Dias antes de la caducidad en que el producto entra en alerta.
  expiryAlertDays Int?         @map("expiry_alert_days")

  version     Int       @default(0)
  createdById String    @map("created_by_id")
  updatedById String    @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit               UnitOfMeasure       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  stockLevels        StockLevel[]
  movements          StockMovement[]
  lots               Lot[]
  serialNumbers      SerialNumber[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines    SalesOrderLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, isActive, name])
  @@index([organizationId, categoryId])
  @@map("products")
}

model Supplier {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  code           String
  name           String
  countryCode    String    @map("country_code") @db.Char(2)
  /// El formato y la etiqueta del identificador fiscal dependen del pais.
  /// La validacion usa el patron declarado en Country.
  taxId          String?   @map("tax_id")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  country        Country         @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  lots           Lot[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, name])
  @@index([countryCode])
  @@map("suppliers")
}

model Customer {
  id             String    @id @default(uuid(7))
  organizationId String    @map("organization_id")
  code           String
  name           String
  countryCode    String    @map("country_code") @db.Char(2)
  taxId          String?   @map("tax_id")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(0)
  createdById    String    @map("created_by_id")
  updatedById    String    @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  country     Country      @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  salesOrders SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, name])
  @@index([countryCode])
  @@map("customers")
}

