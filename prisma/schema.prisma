model PurchaseOrder {
  id             String              @id @default(uuid(7))
  organizationId String              @map("organization_id")
  number         String
  supplierId     String              @map("supplier_id")
  warehouseId    String              @map("warehouse_id")
  status         PurchaseOrderStatus @default(DRAFT)
  orderedAt      DateTime            @map("ordered_at") @db.Timestamptz(6)
  expectedAt     DateTime?           @map("expected_at") @db.Timestamptz(6)
  notes          String?

  /// Moneda en la que se pacto la compra. Puede diferir de la moneda base.
  currencyCode    String  @map("currency_code") @db.Char(3)
  /// Tasa hacia la moneda base, congelada al confirmar el documento. Nunca se
  /// recalcula: un cambio posterior del tipo de cambio no altera el historico.
  exchangeRate    Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  /// Total en la moneda del documento.
  totalAmount     Decimal @default(0) @map("total_amount") @db.Decimal(18, 4)
  /// Mismo total convertido a la moneda base de la organizacion. Se almacena
  /// para que los informes no dependan de una tabla de tasas al consultar.
  totalAmountBase Decimal @default(0) @map("total_amount_base") @db.Decimal(18, 4)

  version     Int      @default(0)
  createdById String   @map("created_by_id")
  updatedById String   @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency  Currency            @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  receipts  PurchaseReceipt[]

  @@unique([organizationId, number])
  @@index([organizationId, status, orderedAt])
  @@index([organizationId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid(7))
  organizationId   String  @map("organization_id")
  purchaseOrderId  String  @map("purchase_order_id")
  productId        String  @map("product_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 4)
  /// Denormalizado desde las recepciones para evitar agregar en cada consulta.
  /// Se actualiza en la misma transaccion que la recepcion.
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal        Decimal @map("line_total") @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  PurchaseReceiptLine[]

  @@unique([purchaseOrderId, productId])
  @@index([organizationId, productId])
  @@map("purchase_order_lines")
}

model PurchaseReceipt {
  id              String   @id @default(uuid(7))
  organizationId  String   @map("organization_id")
  purchaseOrderId String   @map("purchase_order_id")
  number          String
  receivedAt      DateTime @map("received_at") @db.Timestamptz(6)
  notes           String?
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         PurchaseReceiptLine[]

  @@unique([organizationId, number])
  @@index([organizationId, receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                  String  @id @default(uuid(7))
  organizationId      String  @map("organization_id")
  purchaseReceiptId   String  @map("purchase_receipt_id")
  purchaseOrderLineId String  @map("purchase_order_line_id")
  quantity            Decimal @db.Decimal(18, 4)
  unitCost            Decimal @map("unit_cost") @db.Decimal(18, 4)
  /// Lote al que entra la mercancia. Obligatorio si el producto se rastrea por
  /// lote. Se crea en la recepcion si el codigo no existia todavia.
  lotId               String? @map("lot_id")

  receipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderLineId])
  @@map("purchase_receipt_lines")
}

