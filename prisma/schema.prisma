  salesOrderId    String  @map("sales_order_id")
  productId       String  @map("product_id")
  quantityOrdered Decimal @map("quantity_ordered") @db.Decimal(18, 4)
  quantityShipped Decimal @default(0) @map("quantity_shipped") @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 4)

  salesOrder    SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  shipmentLines SalesShipmentLine[]

  @@unique([salesOrderId, productId])
  @@index([organizationId, productId])
  @@map("sales_order_lines")
}

model SalesShipment {
  id             String   @id @default(uuid(7))
  organizationId String   @map("organization_id")
  salesOrderId   String   @map("sales_order_id")
  number         String
  shippedAt      DateTime @map("shipped_at") @db.Timestamptz(6)
  notes          String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  salesOrder SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines      SalesShipmentLine[]

  @@unique([organizationId, number])
  @@index([organizationId, shippedAt])
  @@map("sales_shipments")
