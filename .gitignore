.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials.json
serviceAccount*.json

# Construcción
.next/
out/
dist/
build/
*.tsbuildinfo

# Pruebas y cobertura
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Registros y temporales
*.log
npm-debug.log*
yarn-error.log*
.cache/
tmp/

