# Plantilla de variables de entorno.
#
# Copia este archivo a .env y rellena los valores para tu entorno de desarrollo.
# .env NUNCA se versiona. Este archivo SÍ se versiona y jamás contiene valores
# reales: todos los ejemplos de abajo son ficticios.
#
# Reglas completas en docs/standards/configuration-and-secrets.md
#
# Leyenda:  [req] obligatoria   [opt] opcional con valor por omisión
#           [pub] se incrusta en el paquete del navegador, debe ser pública


# --- Entorno -----------------------------------------------------------------

# [req] development | test | production
NODE_ENV=development

# [opt] error | warn | info | debug
LOG_LEVEL=debug


# --- Base de datos -----------------------------------------------------------
# Dos roles distintos por mínimo privilegio: la aplicación solo lee y escribe
# datos, el migrador es el único que puede alterar la estructura.
# El guion scripts/db/bootstrap.sql crea ambos.

# [req] SECRETO. Rol de aplicación. En producción se obtiene del gestor de
#       secretos, no de esta variable.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/inventario_dev?schema=public

# [req] SECRETO. Rol de migraciones, con permisos de estructura.
DIRECT_DATABASE_URL=postgresql://migrador:contrasena@localhost:5432/inventario_dev?schema=public

# [opt] SECRETO. Base independiente para la suite de integración. Se vacía en
#       cada ejecución, así que nunca debe apuntar a datos que importen.
TEST_DATABASE_URL=postgresql://migrador:contrasena@localhost:5432/inventario_test?schema=public


# --- Autenticación -----------------------------------------------------------
# Sesión propia en base de datos, sin librería externa. Ver ADR 0007.

# [req] SECRETO. Clave de firma de la cookie de sesión.
#       Genera una con: openssl rand -base64 32
AUTH_SECRET=reemplaza-esto-por-un-valor-generado-de-32-bytes

# [req] URL base de la aplicación para los enlaces de correo.
AUTH_URL=http://localhost:3000

# [opt] required | skipped
#       Segundo factor del super administrador antes de entrar a una empresa.
#       El ADR 0005 lo exige, así que el valor por omisión es "required".
#       "skipped" solo surte efecto fuera de producción, mientras las pantallas
#       de alta del segundo factor no existan. En producción la variable ni se
#       mira: el segundo factor se exige siempre.
PLATFORM_ADMIN_TWO_FACTOR=required


# --- Correo ------------------------------------------------------------------
# Necesario para la recuperación de contraseña y las invitaciones.

# [opt] SECRETO. Servidor de correo saliente.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=inventario@example.test


# --- Gestor de secretos en la nube -------------------------------------------

# [opt] Proveedor de secretos en despliegue: azure | aws | env
#       Con el valor "env" la aplicación lee de estas variables, solo para local.
SECRETS_PROVIDER=env

# [opt] Nombre del secreto agrupado en Azure Key Vault o AWS Secrets Manager.
#       Las credenciales de acceso NO se declaran aquí: en la nube se usa
#       identidad administrada, así no hay una clave que guardar para leer claves.
SECRETS_NAME=inventario/produccion


# --- Valores públicos ---------------------------------------------------------
# Todo lo que lleve el prefijo NEXT_PUBLIC_ viaja al navegador y es visible para
# cualquiera. Añadir una variable aquí requiere revisión de una segunda persona.

# [pub] URL pública de la aplicación.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [pub] Nombre visible del entorno, para el distintivo de la interfaz.
NEXT_PUBLIC_ENVIRONMENT_LABEL=Desarrollo


# --- Semilla ------------------------------------------------------------------
# Cuenta inicial de super administrador. Solo la lee el guion de siembra.
# La contraseña es temporal: la cuenta nace obligada a cambiarla al entrar.

# [req] Correo de la primera cuenta.
SEED_ADMIN_EMAIL=admin@example.test
# [req] SECRETO. Mínimo doce caracteres.
SEED_ADMIN_PASSWORD=
